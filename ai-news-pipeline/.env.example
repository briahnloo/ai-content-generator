OPENAI_API_KEY=sk-...
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# YouTube OAuth (run `python cli.py auth` to generate)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Pipeline
DATABASE_PATH=./data/pipeline.db
VIDEO_OUTPUT_DIR=./data/videos
MAX_RETRIES=3

# Content Scoring (Enhanced NLP-based quality filter - Political/Economic Focus)
ENABLE_SCORING=true
MIN_CONTENT_SCORE=50.0                    # Threshold (0-100), 50=political/economic focus, 60=very selective, 70=critical only
REQUIRE_HARD_NEWS=false                    # If true, reject all non-Tier 1 hard news
FLUFF_PENALTY_MULTIPLIER=1.5              # How harsh on fluff (1.0-2.0), 1.5 = reasonably aggressive

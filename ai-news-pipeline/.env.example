OPENAI_API_KEY=sk-...
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# YouTube OAuth (run `python cli.py auth` to generate)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Pipeline
DATABASE_PATH=./data/pipeline.db
VIDEO_OUTPUT_DIR=./data/videos
MAX_RETRIES=3

# Content Scoring (NLP-based quality filter)
ENABLE_SCORING=true
MIN_CONTENT_SCORE=50.0
